# CroweCad Environment Variables

# Database Configuration
DATABASE_URL=postgresql://crowecad:crowecad_password@localhost:5432/crowecad
PGUSER=crowecad
PGPASSWORD=crowecad_password
PGDATABASE=crowecad
PGHOST=localhost
PGPORT=5432

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=asst_your_assistant_id_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Configuration (for skill mining)
GITHUB_TOKEN=your_github_token_here

# Application Settings
NODE_ENV=development
PORT=5000

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# Session Secret
SESSION_SECRET=your_session_secret_here

# Storage Configuration
STORAGE_TYPE=postgres  # Options: memory, postgres
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes

# Feature Flags
ENABLE_AI=true
ENABLE_COLLABORATION=true
ENABLE_SKILL_MINING=true
ENABLE_CODE_INTERPRETER=true