# CroweCad Environment Variables

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://crowecad:crowecad_password@localhost:5432/crowecad
PGUSER=crowecad
PGPASSWORD=crowecad_password
PGDATABASE=crowecad
PGHOST=localhost
PGPORT=5432

# Autodesk Platform Services (REQUIRED for CAD viewer)
APS_CLIENT_ID=your_aps_client_id_here
APS_CLIENT_SECRET=your_aps_client_secret_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=asst_your_assistant_id_here

# Anthropic Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub Configuration (for skill mining)
GITHUB_TOKEN=your_github_token_here

# Application Settings
NODE_ENV=development  # Options: development, production, staging
PORT=5000
LOG_LEVEL=info  # Options: error, warn, info, debug

# Security (REQUIRED for production)
SESSION_SECRET=change_this_to_random_32_char_string_in_production
CORS_ORIGIN=http://localhost:5000  # Change to your domain in production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Redis Configuration (recommended for production)
REDIS_URL=redis://localhost:6379

# Storage Configuration
STORAGE_TYPE=postgres  # Options: memory, postgres
MAX_UPLOAD_SIZE=52428800  # 50MB in bytes
UPLOAD_TEMP_DIR=/tmp/uploads

# Feature Flags
ENABLE_AI=true
ENABLE_COLLABORATION=true
ENABLE_SKILL_MINING=true
ENABLE_CODE_INTERPRETER=true

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=